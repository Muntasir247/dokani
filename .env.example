# -----------------------------------------------------------------------------
# Dokani Environment Configuration Reference
# Copy to .env.local for local development.
# -----------------------------------------------------------------------------

# Supabase Public Configuration (accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZWZlcmVuY2VfaWQiOiJsb2NhbCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzA0MDY3MjAwLCJleHAiOjIwMTk2NDMyMDB9.mock-anon-key-for-local-development-only

# Supabase Admin / Service Role (SERVER-ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZWZlcmVuY2VfaWQiOiJsb2NhbCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MDQwNjcyMDAsImV4cCI6MjAxOTY0MzIwMH0.mock-service-role-key-for-local-development-only

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Locale & Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Dhaka

# -----------------------------------------------------------------------------
# Security & Encryption (AES-256-GCM for tenant courier credentials)
# Must be exactly 32 bytes (256-bit key)
# -----------------------------------------------------------------------------
COURIER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# Payment Gateways (Bangladesh SaaS Billing)
# -----------------------------------------------------------------------------

# SSLCommerz (Primary Payment Gateway for Bangladesh)
# Sandbox credentials: https://developer.sslcommerz.com
SSLCOMMERZ_STORE_ID=dokani_test
SSLCOMMERZ_STORE_PASSWD=dokani_pass
SSLCOMMERZ_IS_LIVE=false

# bKash Tokenized Checkout
# Sandbox credentials: https://developer.bka.sh
BKASH_APP_KEY=bkash_sandbox_key
BKASH_APP_SECRET=bkash_sandbox_secret
BKASH_USERNAME=sandbox_user
BKASH_PASSWORD=sandbox_pass
BKASH_IS_LIVE=false

# -----------------------------------------------------------------------------
# Courier Integrations (Sandbox / Defaults)
# -----------------------------------------------------------------------------
STEADFAST_API_KEY=stf_sandbox_key
STEADFAST_SECRET_KEY=stf_sandbox_secret
PATHAO_CLIENT_ID=pth_sandbox_id
PATHAO_CLIENT_SECRET=pth_sandbox_secret

# -----------------------------------------------------------------------------
# Observability & Error Tracking
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Transactional Emails (Resend Provider)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_mock_test_key_for_development
EMAIL_FROM=Dokani Billing <billing@dokani.app>
